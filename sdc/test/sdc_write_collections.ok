###############################################################################
# Created by write_sdc
###############################################################################
current_design sdc_test2
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name clk1 -period 10.0000 [get_ports {clk1}]
create_clock -name clk2 -period 10.0000 [get_ports {clk2}]
group_path -name io\
    -from [all_inputs]\
    -to [all_outputs]
set_max_delay\
    -from [all_registers]\
    -to [all_outputs] 6.0000
set_max_delay\
    -from [all_inputs -no_clocks]\
    -to [all_registers] 5.0000
set_false_path\
    -from [list [get_cells {reg1}]\
           [get_cells {reg2}]]\
    -to [all_registers]
###############################################################################
# Environment
